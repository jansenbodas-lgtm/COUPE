{
  // Worker "coupe" (Cloudflare Workers Builds): landing page + CRM em /admin
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coupe",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // a página principal passa pelo Worker (cookies próprios + PageView pelo servidor)
    "run_worker_first": ["/", "/index.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coupe-crm",
      "database_id": "df32d7f9-94e1-4cd7-b2dd-3370a4a1a43d"
    }
  ],
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ],
  "vars": {
    // ID do pixel da Meta (público), o mesmo do ON Resort.
    // O token vai como Secret META_CAPI_TOKEN no painel do Cloudflare, nunca aqui.
    "META_PIXEL_ID": "650460263189144",
    // domínio oficial: o endereço *.workers.dev redireciona para cá (CRM e API seguem nos dois)
    "SITE_URL": "https://coupe.lancamentocyrela.com.br"
  },
  "keep_vars": true,
  "observability": { "enabled": true }
}
